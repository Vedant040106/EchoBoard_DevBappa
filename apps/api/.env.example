# DevBappa Solutions Live Feedback Wall - API Configuration
NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string (with SSL mode)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devbappa_feedback

# Allowed origins for CORS (comma separated for multiple origins)
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Session Secret (Generate a strong 64-char random string in production)
SESSION_SECRET=devbappa-super-secret-session-key-change-in-production-min-32-chars

# Initial Admin Credentials for first-time bootstrap (Do NOT commit real credentials)
ADMIN_INITIAL_ID=admin
ADMIN_INITIAL_PASSWORD=ChangeMeInProduction123!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_SUBMISSIONS=25
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=10
